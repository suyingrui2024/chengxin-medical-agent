# Copy this file to .env for explicit local --live development and testing.
# Normal application startup does not load it. Never commit the copied .env.
# compatible = Chat Completions; dsh = DeepSeek Messages.
MEDAGENT_BACKEND=dsh
MEDAGENT_LLM_BASE_URL=https://api.deepseek.com/anthropic
MEDAGENT_LLM_API_KEY=replace-me
MEDAGENT_LLM_MODEL=deepseek-v4-flash
# Optional image model. DeepSeek's official endpoint defaults to deepseek-flash.
MEDAGENT_VISION_MODEL=deepseek-flash
# shadow only records bounded review telemetry; advisory is an evaluated opt-in.
MEDAGENT_DSH_REVIEW_MODE=shadow

