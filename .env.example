# Copy this complete example to .env for explicit local --live development.
# Platform helpers in scripts/config/<platform>/ can generate both layers.
# Normal application startup does not load local env files. Never commit them.

# Common model-service layer.
MEDAGENT_LLM_API_KEY=replace-me
MEDAGENT_LLM_MODEL=deepseek-flash
MEDAGENT_VISION_MODEL=deepseek-flash
# Thinking (V4 generation): disabled by default for deterministic,
# low-latency decisions. When enabled, MEDAGENT_LLM_REASONING_EFFORT
# grades it — official guidance: simple tasks low, everyday agent
# work high, hardest cases max. Note thinking mode ignores
# temperature, and DSH mode maps these through the bridge.
# MEDAGENT_LLM_THINKING=disabled
# MEDAGENT_LLM_REASONING_EFFORT=high
# MEDAGENT_LLM_MAX_TOKENS=2048

# DSH overlay layer: runtime, Messages endpoint and bounded review policy.
MEDAGENT_BACKEND=dsh
MEDAGENT_LLM_BASE_URL=https://api.deepseek.com/anthropic
# shadow only records bounded review telemetry; advisory is an evaluated opt-in.
MEDAGENT_DSH_REVIEW_MODE=shadow

