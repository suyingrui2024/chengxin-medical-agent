# This file is documentation; the app does not automatically load it.
# demo = offline scripted flow; compatible = Chat Completions; dsh = DeepSeek Messages.
MEDAGENT_BACKEND=demo
# For dsh use https://api.deepseek.com/anthropic or a compatible Messages endpoint.
MEDAGENT_LLM_BASE_URL=https://your-endpoint.example/v1
MEDAGENT_LLM_API_KEY=replace-me
MEDAGENT_LLM_MODEL=replace-me
# Optional image model. DeepSeek's official endpoint defaults to deepseek-flash.
MEDAGENT_VISION_MODEL=deepseek-flash
# shadow only records bounded review telemetry; advisory is an evaluated opt-in.
MEDAGENT_DSH_REVIEW_MODE=shadow

