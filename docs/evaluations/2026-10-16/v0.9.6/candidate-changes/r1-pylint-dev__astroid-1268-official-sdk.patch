+# Licensed under the LGPL: https://www.gnu.org/licenses/old-licenses/lgpl-2.1.en.html
+# For details: https://github.com/PyCQA/astroid/blob/main/LICENSE
+
+"""Regression test for rendering the synthetic ``Unknown`` node as a string."""
+
+from astroid import nodes
+
+
+def test_unknown_as_string() -> None:
+    """``Unknown().as_string()`` must not raise and should render a name."""
+    assert nodes.Unknown().as_string() == "Unknown"
