+"""Regression test for rendering an ``Unknown`` node with ``as_string``."""
+
+from astroid import nodes
+
+
+def test_unknown_as_string() -> None:
+    """``Unknown().as_string()`` should not raise and render a stable name."""
+    assert nodes.Unknown().as_string() == "Unknown"
