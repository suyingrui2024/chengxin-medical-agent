+# Regression tests: PersonName should support str-like iteration and
+# membership tests ("'S' in pn"). See issue "Make PersonName iterable".
+import pytest
+
+from pydicom import Dataset
+from pydicom.valuerep import PersonName
+
+
+class TestPersonNameIterable:
+    def test_contains_single_char(self):
+        assert 'S' in PersonName('SomeName')
+
+    def test_contains_substring(self):
+        assert 'ome' in PersonName('SomeName')
+        assert 'Other' not in PersonName('SomeName')
+
+    def test_iter_yields_characters_of_str(self):
+        pn = PersonName('SomeName')
+        assert list(pn) == list('SomeName')
+        assert ''.join(pn) == 'SomeName'
+
+    def test_iter_matches_str_for_multiple_components(self):
+        pn = PersonName('Family^Given=Ideo^Graphic=Phone')
+        value = str(pn)
+        assert ''.join(pn) == value
+        assert [c for c in pn] == [c for c in value]
+        assert 'Ideo' in pn
+
+    def test_iter_empty_person_name(self):
+        pn = PersonName('')
+        assert list(pn) == []
+        assert 'x' not in pn
+
+    def test_iter_bytes_backed_person_name(self):
+        # decoded on demand from the original byte string
+        pn = PersonName(b'SomeName')
+        assert 'S' in pn
+        assert list(pn) == list('SomeName')
+
+    def test_dataset_patient_name_membership(self):
+        ds = Dataset()
+        ds.PatientName = 'SomeName'
+        assert 'S' in ds.PatientName
+        assert list(ds.PatientName) == list('SomeName')
+
+    def test_contains_non_str_raises_type_error(self):
+        with pytest.raises(TypeError):
+            None in PersonName('SomeName')
