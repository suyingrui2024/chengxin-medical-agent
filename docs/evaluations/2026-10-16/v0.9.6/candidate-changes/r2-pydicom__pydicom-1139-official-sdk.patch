--- a/pydicom/tests/test_regression_personname_iterable.py
+++ b/pydicom/tests/test_regression_personname_iterable.py
@@ -0,0 +1,37 @@
+"""Regression tests for making PersonName iterable (issue: PersonName3).
+
+These tests verify that a ``PersonName`` value can be used with the ``in``
+operator and can be iterated over, just like the equivalent ``str``.
+"""
+from pydicom import Dataset
+from pydicom.valuerep import PersonName
+
+
+def test_contains_single_character():
+    """The reported case: ``'S' in ds.PatientName`` must work."""
+    ds = Dataset()
+    ds.PatientName = 'SomeName'
+    assert 'S' in ds.PatientName
+    assert 'X' not in ds.PatientName
+
+
+def test_contains_substring():
+    pn = PersonName('Family^Given')
+    assert 'Family' in pn
+    assert 'Given' in pn
+    assert 'Other' not in pn
+
+
+def test_iteration_yields_characters():
+    pn = PersonName('SomeName')
+    assert list(pn) == list('SomeName')
+    assert ''.join(pn) == 'SomeName'
+
+
+def test_iteration_empty():
+    assert list(PersonName('')) == []
+
+
+def test_iteration_unicode():
+    pn = PersonName('Yamada^Tarou=山田^太郎')
+    assert list(pn) == list('Yamada^Tarou=山田^太郎')
