--- a/pydicom/tests/test_json_suppress_invalid_tags.py
+++ b/pydicom/tests/test_json_suppress_invalid_tags.py
@@ -0,0 +1,57 @@
+"""Regression tests for ``Dataset.to_json_dict(suppress_invalid_tags=True)``.
+
+Covers the case where converting a *raw* element raises inside
+``Dataset.__getitem__`` (e.g. an ``IS`` value of ``"2.0"``), which previously
+escaped the ``try``/``except`` block in ``Dataset.to_json_dict`` because the
+element lookup happened outside of it.
+"""
+import pytest
+
+from pydicom import config
+from pydicom.dataelem import RawDataElement
+from pydicom.dataset import Dataset
+from pydicom.tag import Tag
+
+
+@pytest.fixture
+def raise_validation_mode():
+    """Temporarily make value validation raise instead of warn."""
+    original = config.settings.reading_validation_mode
+    config.settings.reading_validation_mode = config.RAISE
+    yield
+    config.settings.reading_validation_mode = original
+
+
+def _dataset_with_invalid_is():
+    """Return a Dataset holding a raw IS element with an invalid value."""
+    ds = Dataset()
+    tag = Tag(0x00200013)  # Instance Number, VR IS
+    ds[tag] = RawDataElement(
+        tag=tag,
+        VR="IS",
+        length=4,
+        value=b"2.0 ",
+        value_tell=0,
+        is_implicit_VR=False,
+        is_little_endian=True,
+    )
+    return ds
+
+
+def test_raw_invalid_is_raises_by_default(raise_validation_mode):
+    """Without suppression the conversion error is still raised."""
+    ds = _dataset_with_invalid_is()
+
+    with pytest.raises(ValueError):
+        ds.to_json_dict()
+
+
+def test_raw_invalid_is_suppressed(raise_validation_mode):
+    """With suppress_invalid_tags=True the invalid tag is dropped."""
+    ds = _dataset_with_invalid_is()
+    ds.add_new(0x00100010, "PN", "Jane^Doe")
+
+    ds_json = ds.to_json_dict(suppress_invalid_tags=True)
+
+    assert ds_json.get("00200013") is None
+    assert ds_json["00100010"]["Value"] == [{"Alphabetic": "Jane^Doe"}]
