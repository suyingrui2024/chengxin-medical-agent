@@ -0,0 +1,23 @@
+"""Regression tests for PersonName iteration (issue: make PersonName iterable)."""
+from pydicom import Dataset
+from pydicom.valuerep import PersonName
+
+
+class TestPersonNameIterable:
+    def test_contains_single_character(self):
+        ds = Dataset()
+        ds.PatientName = 'SomeName'
+        assert 'S' in ds.PatientName
+
+    def test_contains_substring(self):
+        pn = PersonName('Family^Given')
+        assert 'Family' in pn
+        assert 'Given' in pn
+        assert 'Missing' not in pn
+
+    def test_iter_matches_str(self):
+        pn = PersonName('Some^Name')
+        assert list(pn) == list('Some^Name')
+
+    def test_contains_empty(self):
+        assert '' in PersonName('Some^Name')
