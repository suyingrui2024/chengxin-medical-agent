+        #   during Dataset.__getitem__() rather than to_json_dict()
+        ds._dict[Tag(0x00200011)] = RawDataElement(
+            tag=Tag(0x00200011),
+            VR='IS',
+            length=4,
+            value=b'2.5 ',
+            value_tell=0,
+            is_implicit_VR=True,
+            is_little_endian=True,
+        )
+
+        with pytest.raises(TypeError):
+            ds.to_json_dict()
+
+        ds_json = ds.to_json_dict(suppress_invalid_tags=True)
