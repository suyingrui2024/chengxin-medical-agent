--- a/tests/unittest_unknown_as_string.py
+++ b/tests/unittest_unknown_as_string.py
@@ -0,0 +1,25 @@
+# Licensed under the LGPL: https://www.gnu.org/licenses/old-licenses/lgpl-2.1.en.html
+# For details: https://github.com/PyCQA/astroid/blob/main/LICENSE
+
+"""Regression tests for rendering astroid.nodes.Unknown via as_string."""
+
+import astroid
+from astroid import nodes
+
+
+def test_unknown_as_string_does_not_crash() -> None:
+    """Unknown has no Python representation; it should render as empty string."""
+    assert nodes.Unknown().as_string() == ""
+
+
+def test_unknown_as_string_in_module_attribute() -> None:
+    """The visitor must work when Unknown is reached through a parent node."""
+    module = astroid.parse("import os\n", module_name="mod")
+    assert "os" in module.as_string()
+
+
+def test_to_code_visitor_accepts_unknown() -> None:
+    """The shared visitor instance must support the unknown node class."""
+    from astroid.nodes.as_string import AsStringVisitor
+
+    assert AsStringVisitor()(nodes.Unknown()) == ""
