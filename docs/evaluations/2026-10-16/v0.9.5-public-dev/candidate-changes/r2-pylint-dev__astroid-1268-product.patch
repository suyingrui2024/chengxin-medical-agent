+# Licensed under the LGPL: https://www.gnu.org/licenses/old-licenses/lgpl-2.1.en.html
+# For details: https://github.com/PyCQA/astroid/blob/main/LICENSE
+
+"""Regression tests for calling ``as_string`` on nodes that have no source code.
+
+See the report: ``'AsStringVisitor' object has no attribute 'visit_unknown'``.
+"""
+
+import pytest
+
+from astroid import nodes
+
+
+def test_unknown_as_string() -> None:
+    """``Unknown.as_string()`` must not raise ``AttributeError``."""
+    node = nodes.Unknown()
+    assert node.as_string() == str(node)
+
+
+def test_unknown_inside_other_node_as_string() -> None:
+    """An ``Unknown`` nested in another node must be renderable as well."""
+    node = nodes.Tuple()
+    node.postinit([nodes.Unknown()])
+    assert node.as_string() == f"({str(nodes.Unknown())}, )"
+
+
+if __name__ == "__main__":
+    pytest.main([__file__])
