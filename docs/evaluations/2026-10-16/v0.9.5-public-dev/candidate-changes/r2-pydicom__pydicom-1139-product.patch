+# -*- coding: utf-8 -*-
+"""Regression tests: PersonName should support common str-like operations."""
+
+from pydicom import Dataset
+from pydicom.valuerep import PersonName
+
+
+class TestPersonNameIterable:
+    def test_contains(self):
+        ds = Dataset()
+        ds.PatientName = 'SomeName'
+        assert 'S' in ds.PatientName
+        assert 'Some' in ds.PatientName
+        assert 'X' not in ds.PatientName
+
+    def test_iter(self):
+        pn = PersonName('SomeName')
+        assert list(pn) == list('SomeName')
+        assert ''.join(pn) == 'SomeName'
+
+    def test_len_and_indexing(self):
+        pn = PersonName('SomeName')
+        assert len(pn) == 8
+        assert pn[0] == 'S'
+        assert pn[:4] == 'Some'
+        assert pn[-4:] == 'Name'
+
+    def test_components_joined_in_str_ops(self):
+        pn = PersonName('Family^Given=Ideo=Phone')
+        text = 'Family^Given=Ideo=Phone'
+        assert list(pn) == list(text)
+        assert len(pn) == len(text)
+        assert 'Ideo' in pn
