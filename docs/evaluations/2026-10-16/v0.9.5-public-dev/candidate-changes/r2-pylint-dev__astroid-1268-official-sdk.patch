+
+"""Regression tests for rendering an ``Unknown`` node as a string."""
+
+from astroid import nodes, util
+
+
+def test_unknown_as_string() -> None:
+    """``Unknown.as_string`` should not raise and return a stable name."""
+    unknown = nodes.Unknown()
+    assert unknown.as_string() == "Unknown"
+
+
+def test_unknown_infer_and_name() -> None:
+    """Keep the existing behaviour of ``Unknown`` alongside ``as_string``."""
+    unknown = nodes.Unknown()
+    assert isinstance(next(unknown.infer()), type(util.Uninferable))
+    assert unknown.name == "Unknown"
+    assert unknown.qname() == "Unknown"
+    assert unknown.as_string() == unknown.name
