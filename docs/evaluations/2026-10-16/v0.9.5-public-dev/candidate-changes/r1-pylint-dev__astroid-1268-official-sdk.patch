--- a/tests/unittest_unknown_as_string.py
+++ b/tests/unittest_unknown_as_string.py
@@ -0,0 +1,19 @@
+# Licensed under the LGPL: https://www.gnu.org/licenses/old-licenses/lgpl-2.1.en.html
+# For details: https://github.com/PyCQA/astroid/blob/main/LICENSE
+
+"""Regression tests for rendering the Unknown node with ``as_string``."""
+
+from astroid import nodes
+
+
+def test_unknown_as_string() -> None:
+    """``Unknown`` nodes should render without raising an AttributeError."""
+    assert nodes.Unknown().as_string() == "Unknown"
+
+
+def test_unknown_accept_as_string_visitor() -> None:
+    """The visitor should expose a ``visit_unknown`` method."""
+    from astroid.nodes.as_string import AsStringVisitor
+
+    visitor = AsStringVisitor()
+    assert visitor.visit_unknown(nodes.Unknown()) == "Unknown"
