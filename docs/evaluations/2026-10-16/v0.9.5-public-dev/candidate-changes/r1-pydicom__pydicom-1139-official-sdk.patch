--- a/pydicom/tests/test_personname_iterable.py
+++ b/pydicom/tests/test_personname_iterable.py
@@ -0,0 +1,34 @@
+"""Regression tests for iterating over a PersonName value.
+
+See the report: a ``PersonName`` should behave like its string
+representation for iteration/membership so that ``'S' in ds.PatientName``
+works without an explicit ``str()`` conversion.
+"""
+from pydicom import Dataset
+from pydicom.valuerep import PersonName
+
+
+def test_personname_iterable():
+    pn = PersonName("SomeName")
+    assert list(pn) == list("SomeName")
+
+
+def test_personname_contains_char():
+    pn = PersonName("SomeName")
+    assert "S" in pn
+    assert "z" not in pn
+
+
+def test_personname_contains_substring():
+    pn = PersonName("Family^Given")
+    assert "Family" in pn
+    assert "Given" in pn
+    assert "^" in pn
+    assert "Missing" not in pn
+
+
+def test_personname_iterable_via_dataset():
+    ds = Dataset()
+    ds.PatientName = "SomeName"
+    assert "S" in ds.PatientName
+    assert list(ds.PatientName) == list("SomeName")
--- a/pydicom/valuerep.py
