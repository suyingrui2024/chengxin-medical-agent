{
  "id": "observe.location",
  "name": "指出最明显的不适部位",
  "version": "0.3.0",
  "api_version": "medical-capability/v1",
  "kind": "self_check",
  "description": "把你感到不舒服的位置说清楚，帮助下一步定向追问。",
  "permissions": [],
  "review_status": "prototype_requires_clinical_review",
  "ui": "step_task",
  "task": {
    "id": "body_location",
    "result_key": "symptom_location",
    "input_kind": "location",
    "invalidate_on": ["chief_complaint"],
    "request_phrases": ["想按图指出部位", "想按图标出位置", "想标出疼痛部位"],
    "cancel_phrases": ["取消定位", "先不标位置", "不想标出疼痛部位"],
    "title": "指出最明显的不适部位",
    "purpose": "把你感到不舒服的位置说清楚，帮助下一步定向追问。",
    "applies_when": {
      "chief_complaint_contains_any": ["痛", "疼", "皮疹", "痒", "肿"]
    },
    "equipment": [],
    "asset": "/body-location.svg",
    "steps": [
      "看图找到最明显的位置。",
      "选择部位；需要时补充左侧、右侧、范围和是否移动。"
    ],
    "stop_conditions": ["无法确定位置时可跳过"],
    "response_prompt": "选一个部位，或用自己的话描述位置。",
    "options": [
      {
        "label": "头/面部",
        "value": "head"
      },
      {
        "label": "胸部",
        "value": "chest"
      },
      {
        "label": "腹部",
        "value": "abdomen"
      },
      {
        "label": "背/腰部",
        "value": "back"
      },
      {
        "label": "四肢",
        "value": "limbs"
      },
      {
        "label": "其他部位",
        "value": "other"
      },
      {
        "label": "说不清/跳过",
        "value": "skip"
      }
    ],
    "clinical_limits": [
      "这是主观症状定位，不是客观查体或疾病判断。",
      "不需要按压、扭转或诱发疼痛。"
    ],
    "review_status": "prototype_requires_clinical_review"
  },
  "validation": {
    "status": "prototype_requires_clinical_review",
    "scope": "工程流程已测试；图示理解与操作尚未临床审核"
  }
}
