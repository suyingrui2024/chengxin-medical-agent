{
  "id": "calculate.mallampati",
  "name": "Mallampati 气道分级",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "Mallampati 气道分级（Ⅰ–Ⅳ级）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["Mallampati", "气道分级"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 1,
      "max": 4,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "grade",
        "label": "选择最符合的分级",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "Ⅰ级：可见软腭、咽腭弓、悬雍垂"
          },
          {
            "value": 2,
            "label": "Ⅱ级：可见软腭、咽腭弓，悬雍垂被舌根遮挡"
          },
          {
            "value": 3,
            "label": "Ⅲ级：仅见软腭与舌根"
          },
          {
            "value": 4,
            "label": "Ⅳ级：仅见硬腭"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 1,
        "max": 1,
        "key": "class1",
        "label": "Ⅰ级"
      },
      {
        "min": 2,
        "max": 2,
        "key": "class2",
        "label": "Ⅱ级"
      },
      {
        "min": 3,
        "max": 3,
        "key": "class3",
        "label": "Ⅲ级"
      },
      {
        "min": 4,
        "max": 4,
        "key": "class4",
        "label": "Ⅳ级"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "grade": {
        "type": "number",
        "title": "选择最符合的分级",
        "enum": [1, 2, 3, 4]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
