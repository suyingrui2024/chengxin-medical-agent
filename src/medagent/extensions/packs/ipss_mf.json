{
  "id": "calculate.ipss_mf",
  "name": "IPSS 骨髓纤维化预后评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "国际预后评分系统（0–4 分），用于骨髓纤维化风险分层。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["IPSS-MF", "骨髓纤维化预后"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 4,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "i1",
        "label": "年龄",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "65 岁及以下"
          },
          {
            "value": 1,
            "label": "大于 65 岁"
          }
        ]
      },
      {
        "id": "i2",
        "label": "外周血原始细胞",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "低于 1%"
          },
          {
            "value": 1,
            "label": "1% 及以上"
          }
        ]
      },
      {
        "id": "i3",
        "label": "全身症状",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无"
          },
          {
            "value": 1,
            "label": "有"
          }
        ]
      },
      {
        "id": "i4",
        "label": "白细胞计数",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "25 及以下"
          },
          {
            "value": 1,
            "label": "大于 25"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 0,
        "key": "low",
        "label": "低危"
      },
      {
        "min": 1,
        "max": 1,
        "key": "intermediate1",
        "label": "中危 1"
      },
      {
        "min": 2,
        "max": 2,
        "key": "intermediate2",
        "label": "中危 2"
      },
      {
        "min": 3,
        "max": 4,
        "key": "high",
        "label": "高危"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "i1": {
        "type": "number",
        "title": "年龄",
        "enum": [0, 1]
      },
      "i2": {
        "type": "number",
        "title": "外周血原始细胞",
        "enum": [0, 1]
      },
      "i3": {
        "type": "number",
        "title": "全身症状",
        "enum": [0, 1]
      },
      "i4": {
        "type": "number",
        "title": "白细胞计数",
        "enum": [0, 1]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "IPSS for myelofibrosis",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=International+Prognostic+Scoring+System+myelofibrosis",
      "section": "Cervantes F, et al. 2009；4 项合计 0–4 分",
      "accessed": "2026-10-27"
    }
  ]
}
