        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无损伤"
          },
          {
            "value": 1,
            "label": "AIS 1"
          },
          {
            "value": 4,
            "label": "AIS 2"
          },
          {
            "value": 9,
            "label": "AIS 3"
          },
          {
            "value": 16,
            "label": "AIS 4"
          },
          {
            "value": 25,
            "label": "AIS 5"
          }
        ]
      },
      {
        "id": "r2",
        "label": "次重区域简明损伤定级",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无损伤"
          },
          {
            "value": 1,
            "label": "AIS 1"
          },
          {
            "value": 4,
            "label": "AIS 2"
          },
          {
            "value": 9,
            "label": "AIS 3"
          },
          {
            "value": 16,
            "label": "AIS 4"
          },
          {
            "value": 25,
            "label": "AIS 5"
          }
        ]
      },
      {
        "id": "r3",
        "label": "第三重区域简明损伤定级",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无损伤"
          },
          {
            "value": 1,
            "label": "AIS 1"
          },
          {
            "value": 4,
            "label": "AIS 2"
          },
          {
            "value": 9,
            "label": "AIS 3"
          },
          {
            "value": 16,
            "label": "AIS 4"
          },
          {
            "value": 25,
            "label": "AIS 5"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 8,
        "key": "mild",
        "label": "轻度"
      },
      {
        "min": 9,
        "max": 15,
        "key": "moderate",
        "label": "中度"
      },
      {
        "min": 16,
        "max": 24,
        "key": "severe",
        "label": "重度"
      },
      {
        "min": 25,
        "max": 75,
        "key": "critical",
        "label": "极重度"
      }
    ],
    "note": "选项值直接编码 AIS 的平方，因此合计即为 ISS。"
  },
