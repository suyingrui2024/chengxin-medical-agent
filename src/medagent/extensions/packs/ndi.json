{
  "id": "calculate.ndi",
  "name": "NDI 颈痛功能障碍指数",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "Neck Disability Index（10 项，折算 0–100%），用于记录颈痛对日常活动的影响，不作诊断。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "patient",
  "patient_form": "scale_form/v1",
  "aliases": ["NDI", "颈痛功能障碍", "Neck Disability Index"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum_percent",
      "min": 0,
      "max": 50,
      "unit": "%",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "n1",
        "label": "疼痛程度",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无痛"
          },
          {
            "value": 1,
            "label": "轻微疼痛"
          },
          {
            "value": 2,
            "label": "中度疼痛"
          },
          {
            "value": 3,
            "label": "较重疼痛"
          },
          {
            "value": 4,
            "label": "很重疼痛"
          },
          {
            "value": 5,
            "label": "最重疼痛"
          }
        ]
      },
      {
        "id": "n2",
        "label": "个人照料",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "正常，不需要帮助"
          },
          {
            "value": 1,
            "label": "正常但会加重疼痛"
          },
          {
            "value": 2,
            "label": "需要帮助但能自理"
          },
          {
            "value": 3,
            "label": "大部分需要帮助"
