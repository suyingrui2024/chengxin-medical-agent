          {
            "value": 3,
            "label": "只能做轻工作"
          },
          {
            "value": 4,
            "label": "几乎不能工作"
          },
          {
            "value": 5,
            "label": "完全不能工作"
          }
        ]
      },
      {
        "id": "n8",
        "label": "驾驶",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "能驾驶且不痛"
          },
          {
            "value": 1,
            "label": "能驾驶但会痛"
