  },
  "formula": {
    "engine": "formula-engine/v1",
    "function": "vaccine_due",
    "citation": "VACCINE-INTERVAL",
    "inputs": [
      {
        "id": "last_dose",
        "label": "上一剂接种日期",
        "type": "date",
        "min": "2000-01-01",
