        "unit": "月",
        "min": "1",
        "max": "120",
        "step": "1"
      },
      {
        "id": "today",
        "label": "记录日期",
        "type": "date",
        "min": "2000-01-01",
        "max": "2100-12-31"
      }
    ],
    "output": {
      "label": "距下次接种",
      "unit": "天",
      "min": "-3650",
      "max": "3650",
      "precision": {
        "places": 0
