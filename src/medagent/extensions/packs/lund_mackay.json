{
  "id": "calculate.lund_mackay",
  "name": "Lund-Mackay 鼻窦评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "鼻窦 CT 评分（6 个窦腔，0–12 分）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
