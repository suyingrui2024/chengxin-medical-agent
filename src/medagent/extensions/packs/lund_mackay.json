        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "通畅"
          },
          {
            "value": 1,
            "label": "部分阻塞"
          },
          {
            "value": 2,
            "label": "完全阻塞"
          }
        ]
      }
