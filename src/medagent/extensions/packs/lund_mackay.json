          {
            "value": 1,
            "label": "部分混浊"
          },
          {
            "value": 2,
            "label": "完全混浊"
          }
        ]
      },
      {
        "id": "m4",
        "label": "蝶窦",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无混浊"
          },
          {
            "value": 1,
            "label": "部分混浊"
          },
          {
            "value": 2,
            "label": "完全混浊"
          }
        ]
      },
      {
        "id": "m5",
        "label": "额窦",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无混浊"
          },
          {
            "value": 1,
            "label": "部分混浊"
          },
          {
            "value": 2,
            "label": "完全混浊"
          }
        ]
      },
      {
        "id": "m6",
        "label": "窦口鼻道复合体",
