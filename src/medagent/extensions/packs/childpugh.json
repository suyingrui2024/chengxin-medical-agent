{
  "id": "calculate.childpugh",
  "name": "Child-Pugh 分级",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "肝硬化严重度分级（5 项，5–15 分），对应 A/B/C 三级。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["Child-Pugh", "Child Pugh"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 5,
      "max": 15,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "p1",
        "label": "总胆红素",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "轻度"
          },
          {
            "value": 2,
            "label": "中度"
          },
          {
            "value": 3,
            "label": "重度"
          }
        ]
      },
      {
        "id": "p2",
        "label": "血清白蛋白",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "轻度"
          },
          {
            "value": 2,
            "label": "中度"
          },
          {
            "value": 3,
            "label": "重度"
          }
        ]
      },
      {
        "id": "p3",
        "label": "凝血酶原时间或 INR",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "轻度"
          },
          {
            "value": 2,
            "label": "中度"
          },
          {
            "value": 3,
            "label": "重度"
          }
        ]
      },
      {
        "id": "p4",
        "label": "腹水",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "轻度"
          },
          {
            "value": 2,
            "label": "中度"
          },
          {
            "value": 3,
            "label": "重度"
          }
        ]
      },
      {
        "id": "p5",
        "label": "肝性脑病",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "轻度"
          },
          {
            "value": 2,
            "label": "中度"
          },
          {
            "value": 3,
            "label": "重度"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 5,
        "max": 6,
        "key": "a",
        "label": "A 级"
      },
      {
        "min": 7,
        "max": 9,
        "key": "b",
        "label": "B 级"
      },
      {
        "min": 10,
        "max": 15,
        "key": "c",
        "label": "C 级"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "p1": {
        "type": "number",
        "title": "总胆红素",
        "enum": [1, 2, 3]
      },
      "p2": {
        "type": "number",
        "title": "血清白蛋白",
        "enum": [1, 2, 3]
      },
      "p3": {
        "type": "number",
        "title": "凝血酶原时间或 INR",
        "enum": [1, 2, 3]
      },
      "p4": {
        "type": "number",
        "title": "腹水",
        "enum": [1, 2, 3]
      },
      "p5": {
        "type": "number",
        "title": "肝性脑病",
        "enum": [1, 2, 3]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Child-Pugh score",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Child-Pugh+score+cirrhosis+severity",
      "section": "Child CG, Turcotte JG. 1964；Pugh RN, et al. 1973；5 项各 1–3 分",
      "accessed": "2026-10-27"
    }
  ]
}
