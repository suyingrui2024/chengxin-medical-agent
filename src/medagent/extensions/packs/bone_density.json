{
  "id": "calculate.bone_density",
  "name": "骨密度 T 值判读",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "按 T 值归类骨密度状态（分级型），不作诊断。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["骨密度", "T 值"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 3,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "grade",
        "label": "T 值范围",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "T 值 −1.0 及以上"
          },
          {
            "value": 1,
            "label": "T 值 −1.0 至 −2.5"
          },
          {
            "value": 2,
            "label": "T 值 −2.5 及以下"
          },
          {
            "value": 3,
            "label": "T 值 −2.5 及以下且有脆性骨折"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 0,
        "key": "normal",
        "label": "正常"
      },
      {
        "min": 1,
        "max": 1,
        "key": "osteopenia",
        "label": "骨量减少"
      },
      {
        "min": 2,
        "max": 2,
        "key": "osteoporosis",
        "label": "骨质疏松范围"
      },
      {
        "min": 3,
        "max": 3,
        "key": "severe",
        "label": "严重骨质疏松范围"
      }
    ],
    "note": "只做区间归类，不构成骨质疏松诊断。"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "grade": {
        "type": "number",
        "title": "T 值范围",
        "enum": [0, 1, 2, 3]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "WHO bone density classification",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=WHO+bone+mineral+density+T-score+classification",
      "section": "WHO 骨密度分类；按 T 值分档",
      "accessed": "2026-10-27"
    }
  ]
}
