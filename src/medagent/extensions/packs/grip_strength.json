{
  "id": "calculate.grip_strength",
  "name": "握力判读",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "按握力值归类（分级型），需结合性别与年龄判读。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "patient",
  "aliases": ["握力", "握力判读"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 1,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "level",
        "label": "惯用手握力",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "男 28 公斤以上、女 18 公斤以上"
          },
          {
            "value": 1,
            "label": "男 28 公斤及以下、女 18 公斤及以下"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 0,
        "key": "normal",
        "label": "常见范围"
      },
      {
        "min": 1,
        "max": 1,
        "key": "low",
        "label": "偏低"
      }
    ],
    "note": "只做界值归类，不构成肌少症诊断。"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "level": {
        "type": "number",
        "title": "惯用手握力",
        "enum": [0, 1]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Grip strength cut-offs",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=grip+strength+cut-off+sarcopenia",
      "section": "常用肌少症筛查界值；判读须结合性别与年龄",
      "accessed": "2026-10-27"
    }
  ],
  "patient_form": "scale_form/v1"
}
