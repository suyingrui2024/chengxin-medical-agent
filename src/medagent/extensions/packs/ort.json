{
  "id": "calculate.ort",
  "name": "ORT 阿片风险工具",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "阿片类药物使用风险筛查（4 项，0–4 分）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["ORT", "阿片风险"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 4,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "o1",
        "label": "既往或现有药物滥用史",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "o2",
        "label": "既往或现有酒精滥用史",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "o3",
        "label": "既往或现有精神疾病史",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "o4",
        "label": "既往或现有法律问题",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 0,
        "key": "low",
        "label": "低风险"
      },
      {
        "min": 1,
        "max": 1,
        "key": "moderate",
        "label": "中等风险"
      },
      {
        "min": 2,
        "max": 4,
        "key": "high",
        "label": "高风险"
      }
    ],
    "note": "仅用于风险筛查，不决定是否处方。"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "o1": {
        "type": "number",
        "title": "既往或现有药物滥用史",
        "enum": [0, 1]
      },
      "o2": {
        "type": "number",
        "title": "既往或现有酒精滥用史",
        "enum": [0, 1]
      },
      "o3": {
        "type": "number",
        "title": "既往或现有精神疾病史",
        "enum": [0, 1]
      },
      "o4": {
        "type": "number",
        "title": "既往或现有法律问题",
        "enum": [0, 1]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Opioid Risk Tool",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Opioid+Risk+Tool+ORT",
      "section": "Webster LR, Webster RM. 2005；4 项合计 0–4 分",
      "accessed": "2026-10-27"
    }
  ]
}
