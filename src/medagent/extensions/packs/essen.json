{
  "id": "calculate.essen",
  "name": "Essen 卒中复发风险评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "缺血性卒中复发风险评分（0–9 分）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["Essen", "卒中复发风险"],
  "validation": {
    "status": "engineering_prototype_requires_review",
