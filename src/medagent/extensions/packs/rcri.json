{
  "id": "calculate.rcri",
  "name": "RCRI 心脏风险指数",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "修订心脏风险指数（6 项，0–6 分）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
