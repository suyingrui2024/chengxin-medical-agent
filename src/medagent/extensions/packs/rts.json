{
  "id": "calculate.rts",
  "name": "RTS 创伤生理评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "修订创伤评分（0–12 分），由格拉斯哥昏迷评分、收缩压、呼吸频率编码后相加。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["RTS", "修订创伤评分"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 12,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "gcs",
        "label": "格拉斯哥昏迷评分",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 4,
            "score": 0
          },
          {
            "gte": 4,
            "lt": 6,
            "score": 1
          },
          {
            "gte": 6,
            "lt": 9,
            "score": 2
          },
          {
            "gte": 9,
            "lt": 13,
            "score": 3
          },
          {
            "gte": 13,
            "score": 4
          }
        ]
      },
      {
        "id": "sbp",
        "label": "收缩压",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 1,
            "score": 0
          },
          {
            "gte": 1,
            "lt": 50,
            "score": 1
          },
          {
            "gte": 50,
            "lt": 76,
            "score": 2
          },
          {
            "gte": 76,
            "lt": 90,
            "score": 3
          },
          {
            "gte": 90,
            "score": 4
          }
        ]
      },
      {
        "id": "rr",
        "label": "呼吸频率",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 1,
            "score": 0
          },
          {
            "gte": 1,
            "lt": 6,
            "score": 1
          },
          {
            "gte": 6,
            "lt": 10,
            "score": 2
          },
          {
            "gte": 10,
            "lt": 30,
            "score": 4
          },
          {
            "gte": 30,
            "score": 3
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 3,
        "key": "critical",
        "label": "极重度"
      },
      {
        "min": 4,
        "max": 6,
        "key": "severe",
        "label": "重度"
      },
      {
        "min": 7,
        "max": 11,
        "key": "moderate",
        "label": "中度"
      },
      {
        "min": 12,
        "max": 12,
        "key": "mild",
        "label": "轻度"
      }
    ],
    "note": "编码值越低伤情越重，本量表方向与多数评分相反。"
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "gcs": {
        "type": "number",
        "title": "格拉斯哥昏迷评分"
      },
      "sbp": {
        "type": "number",
        "title": "收缩压"
      },
      "rr": {
        "type": "number",
        "title": "呼吸频率"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Revised Trauma Score",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Revised+Trauma+Score+RTS",
      "section": "Champion HR, et al. 1989；三项编码值相加 0–12 分",
      "accessed": "2026-10-27"
    }
  ]
}
