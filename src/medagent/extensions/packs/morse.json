          },
          {
            "value": 25,
            "label": "有"
          }
        ]
      },
      {
        "id": "m2",
        "label": "次要诊断",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无"
          },
          {
            "value": 15,
            "label": "有"
          }
        ]
      },
      {
        "id": "m3",
        "label": "行走辅助",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无或卧床"
          },
          {
            "value": 15,
            "label": "拐杖或助行器"
          },
          {
            "value": 30,
            "label": "扶家具行走"
          }
        ]
      },
      {
        "id": "m4",
        "label": "静脉输液或肝素锁",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "无"
          },
          {
            "value": 20,
            "label": "有"
          }
        ]
      },
      {
        "id": "m5",
        "label": "步态",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "正常或卧床"
          },
          {
            "value": 10,
            "label": "虚弱"
          },
          {
            "value": 20,
            "label": "步态障碍"
          }
        ]
      },
      {
        "id": "m6",
        "label": "精神状态",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "认知正常"
          },
          {
            "value": 15,
            "label": "高估或忘记自身限制"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 24,
        "key": "low",
        "label": "低风险"
      },
      {
        "min": 25,
        "max": 44,
        "key": "moderate",
        "label": "中等风险"
      },
      {
        "min": 45,
        "max": 125,
        "key": "high",
        "label": "高风险"
      }
    ]
