{
  "id": "calculate.hunt_hess",
  "name": "Hunt-Hess 分级",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "蛛网膜下腔出血临床分级（Ⅰ–Ⅴ级）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["Hunt-Hess", "蛛网膜下腔出血分级"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 1,
      "max": 5,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "grade",
        "label": "选择最符合的分级",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 1,
            "label": "Ⅰ级：无症状或轻微头痛、轻度颈强直"
          },
          {
            "value": 2,
            "label": "Ⅱ级：中重度头痛、颈强直，无神经功能缺失"
          },
          {
            "value": 3,
            "label": "Ⅲ级：嗜睡、轻度定向障碍或轻度局灶缺失"
          },
          {
            "value": 4,
            "label": "Ⅳ级：昏迷、中重度偏瘫"
          },
          {
            "value": 5,
            "label": "Ⅴ级：深昏迷、去大脑强直"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 1,
        "max": 1,
        "key": "grade1",
        "label": "Ⅰ级"
      },
      {
        "min": 2,
        "max": 2,
        "key": "grade2",
        "label": "Ⅱ级"
      },
      {
        "min": 3,
        "max": 3,
        "key": "grade3",
        "label": "Ⅲ级"
      },
      {
        "min": 4,
        "max": 4,
        "key": "grade4",
        "label": "Ⅳ级"
      },
      {
        "min": 5,
        "max": 5,
        "key": "grade5",
        "label": "Ⅴ级"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "grade": {
        "type": "number",
        "title": "选择最符合的分级",
        "enum": [1, 2, 3, 4, 5]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Hunt-Hess grading",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Hunt+and+Hess+grading+subarachnoid+hemorrhage",
      "section": "Hunt WE, Hess RM. 1968；Ⅰ–Ⅴ级",
      "accessed": "2026-10-27"
    }
  ]
}
