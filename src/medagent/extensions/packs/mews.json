{
  "id": "calculate.mews",
  "name": "MEWS 改良早期预警评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "改良早期预警评分（0–14 分），分数越高风险越高。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["MEWS", "早期预警评分"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 14,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "sbp",
        "label": "收缩压",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 71,
            "score": 3
          },
          {
            "gte": 71,
            "lt": 81,
            "score": 2
          },
          {
            "gte": 81,
            "lt": 101,
            "score": 1
          },
          {
            "gte": 101,
            "lt": 200,
            "score": 0
          },
          {
            "gte": 200,
            "score": 2
          }
        ]
      },
      {
        "id": "hr",
        "label": "心率",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 41,
            "score": 2
          },
          {
            "gte": 41,
            "lt": 51,
            "score": 1
          },
          {
            "gte": 51,
            "lt": 101,
            "score": 0
          },
          {
            "gte": 101,
            "lt": 111,
            "score": 1
          },
          {
            "gte": 111,
            "lt": 130,
            "score": 2
          },
          {
            "gte": 130,
            "score": 3
          }
        ]
      },
      {
        "id": "rr",
        "label": "呼吸频率",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 9,
            "score": 2
          },
          {
            "gte": 9,
            "lt": 15,
            "score": 0
          },
          {
            "gte": 15,
            "lt": 21,
            "score": 1
          },
          {
            "gte": 21,
            "lt": 30,
            "score": 2
          },
          {
            "gte": 30,
            "score": 3
          }
        ]
      },
      {
        "id": "temp",
        "label": "体温",
        "kind": "threshold_table",
        "weight": 1,
        "thresholds": [
          {
            "lt": 35,
            "score": 2
          },
          {
            "gte": 35,
            "lt": 38.5,
            "score": 0
          },
          {
            "gte": 38.5,
            "score": 2
          }
        ]
      },
      {
        "id": "avpu",
        "label": "意识",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "清醒"
          },
          {
            "value": 1,
            "label": "对声音有反应"
          },
          {
            "value": 2,
            "label": "对疼痛有反应"
          },
          {
            "value": 3,
            "label": "无反应"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 2,
        "key": "low",
        "label": "低风险"
      },
      {
        "min": 3,
        "max": 4,
        "key": "moderate",
        "label": "中等风险"
      },
      {
        "min": 5,
        "max": 14,
        "key": "high",
        "label": "高风险"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "sbp": {
        "type": "number",
        "title": "收缩压"
      },
      "hr": {
        "type": "number",
        "title": "心率"
      },
      "rr": {
        "type": "number",
        "title": "呼吸频率"
      },
      "temp": {
        "type": "number",
        "title": "体温"
      },
      "avpu": {
        "type": "number",
        "title": "意识",
        "enum": [0, 1, 2, 3]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "Modified Early Warning Score",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=Modified+Early+Warning+Score+MEWS",
      "section": "Subbe CP, et al. 2001；5 项合计 0–14 分",
      "accessed": "2026-10-27"
    }
  ]
}
