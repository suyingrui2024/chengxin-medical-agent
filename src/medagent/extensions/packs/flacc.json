{
  "id": "calculate.flacc",
  "name": "FLACC 儿童疼痛评分",
  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "FLACC 行为疼痛评分（5 项，0–10 分）。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
  "result_renderer": "scale/v1",
  "audience": "clinician",
  "aliases": ["FLACC", "儿童疼痛"],
  "validation": {
    "status": "engineering_prototype_requires_review",
    "scope": "只按公开量表规则计分与分档，不判断是否患病，不给治疗或用药建议。"
  },
  "scale": {
    "engine": "scale-engine/v1",
    "aggregate": {
      "mode": "sum",
      "min": 0,
      "max": 10,
      "unit": "分",
      "direction": "higher_is_worse"
    },
    "items": [
      {
        "id": "f1",
        "label": "面部表情",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "0 分"
          },
          {
            "value": 1,
            "label": "1 分"
          },
          {
            "value": 2,
            "label": "2 分"
          }
        ]
      },
      {
        "id": "f2",
        "label": "腿部动作",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "0 分"
          },
          {
            "value": 1,
            "label": "1 分"
          },
          {
            "value": 2,
            "label": "2 分"
          }
        ]
      },
      {
        "id": "f3",
        "label": "活动",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "0 分"
          },
          {
            "value": 1,
            "label": "1 分"
          },
          {
            "value": 2,
            "label": "2 分"
          }
        ]
      },
      {
        "id": "f4",
        "label": "哭闹",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "0 分"
          },
          {
            "value": 1,
            "label": "1 分"
          },
          {
            "value": 2,
            "label": "2 分"
          }
        ]
      },
      {
        "id": "f5",
        "label": "可安慰性",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "0 分"
          },
          {
            "value": 1,
            "label": "1 分"
          },
          {
            "value": 2,
            "label": "2 分"
          }
        ]
      }
    ],
    "bands": [
      {
        "min": 0,
        "max": 0,
        "key": "none",
        "label": "无痛"
      },
      {
        "min": 1,
        "max": 3,
        "key": "mild",
        "label": "轻度"
      },
      {
        "min": 4,
        "max": 6,
        "key": "moderate",
        "label": "中度"
      },
      {
        "min": 7,
        "max": 10,
        "key": "severe",
        "label": "重度"
      }
    ]
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "f1": {
        "type": "number",
        "title": "面部表情",
        "enum": [0, 1, 2]
      },
      "f2": {
        "type": "number",
        "title": "腿部动作",
        "enum": [0, 1, 2]
      },
      "f3": {
        "type": "number",
        "title": "活动",
        "enum": [0, 1, 2]
      },
      "f4": {
        "type": "number",
        "title": "哭闹",
        "enum": [0, 1, 2]
      },
      "f5": {
        "type": "number",
        "title": "可安慰性",
        "enum": [0, 1, 2]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "unit",
      "max_score",
      "band",
      "items",
      "formula",
      "method",
      "scoring_note",
      "disclaimer",
      "limitations",
      "result_renderer"
    ],
    "properties": {
      "value": {
        "type": "string",
        "title": "得分"
      },
      "unit": {
        "type": "string",
        "title": "单位"
      },
      "max_score": {
        "type": "number",
        "title": "满分"
      },
      "band": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "range": {
            "type": "string"
          }
        }
      },
      "items": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "answer_label", "score"],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "answer_label": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      },
      "formula": {
        "type": "string",
        "title": "计算式"
      },
      "method": {
        "type": "string",
        "title": "计分方式"
      },
      "scoring_note": {
        "type": "string"
      },
      "disclaimer": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        }
      },
      "result_renderer": {
        "type": "string",
        "enum": ["scale/v1"]
      }
    }
  },
  "references": [
    {
      "title": "FLACC behavioural pain scale",
      "url": "https://pubmed.ncbi.nlm.nih.gov/?term=FLACC+scale+paediatric+pain",
      "section": "Merkel SI, et al. 1997；5 项各 0–2 分，合计 0–10 分",
      "accessed": "2026-10-27"
    }
  ]
}
