        "weight": 2,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "c6",
        "label": "血管疾病（心肌梗死、外周动脉病、主动脉斑块）",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "c8",
        "label": "女性",
