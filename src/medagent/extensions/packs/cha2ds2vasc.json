            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "c2",
        "label": "高血压",
        "kind": "choice",
        "weight": 1,
        "options": [
          {
            "value": 0,
            "label": "否"
          },
          {
            "value": 1,
            "label": "是"
          }
        ]
      },
      {
        "id": "c3",
        "label": "年龄",
