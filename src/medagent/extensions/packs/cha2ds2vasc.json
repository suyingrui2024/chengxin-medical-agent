  "version": "1.0.0",
  "api_version": "medical-capability/v1",
  "kind": "calculation",
  "description": "房颤患者卒中风险分层（0–9 分），仅作风险记录，不给抗凝或停药建议。",
  "permissions": [],
  "review_status": "engineering_verified_not_clinical",
  "ui": "calculation",
