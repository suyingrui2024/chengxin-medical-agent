{
  "version": "2026-10-15.v1",
  "questions": [
    {
      "id": "consult_for",
      "phase": "opening",
      "fact_key": "consult_for",
      "prompt": "先确认一下：这次是为谁咨询？",
      "input": "choice",
      "options": [
        {
          "label": "我自己",
          "value": "self"
        },
        {
          "label": "孩子",
          "value": "child"
        },
        {
          "label": "其他家人",
          "value": "other_adult"
        }
      ]
    },
    {
      "id": "age",
      "phase": "opening",
      "fact_key": "age_years",
      "prompt": "患者多大？婴幼儿请尽量写清月龄，例如“8个月”；其他人可写“32岁”。",
      "input": "age"
    },
    {
      "id": "chief_complaint",
      "phase": "opening",
      "fact_key": "chief_complaint",
      "prompt": "这次最想解决的一个问题是什么？请按自己的话说，我会逐步追问。",
      "input": "text"
    },
    {
      "id": "emergency_screen",
      "phase": "emergency_screen",
      "fact_key": "emergency_screen",
      "prompt": "此刻有没有以下任一情况：叫不醒或意识明显异常、抽搐、嘴唇发紫、严重呼吸困难、持续压榨样胸痛，或大出血？",
      "input": "yes_no_unknown",
      "options": [
        {
          "label": "有任一项",
          "value": "yes"
        },
        {
          "label": "都没有",
          "value": "no"
        },
        {
          "label": "不确定",
          "value": "unknown"
        }
      ]
    },
    {
      "id": "onset",
      "phase": "history",
      "fact_key": "onset",
      "prompt": "这个问题从什么时候开始？是突然出现，还是逐渐出现？",
      "input": "text"
    },
    {
      "id": "trajectory",
      "phase": "history",
      "fact_key": "trajectory",
      "prompt": "从开始到现在，总体是在加重、减轻，还是变化不大？",
      "input": "choice",
      "options": [
        {
          "label": "在加重",
          "value": "worsening"
        },
        {
          "label": "在减轻",
          "value": "improving"
        },
        {
          "label": "变化不大",
          "value": "stable"
        },
        {
          "label": "说不清",
          "value": "unknown"
        }
      ]
    },
    {
      "id": "severity",
      "phase": "history",
      "fact_key": "severity",
      "prompt": "如果 0 分是完全不影响，10 分是难以忍受，现在大约几分？也可以直接描述对吃饭、睡觉、活动的影响。",
      "input": "severity"
    },
    {
      "id": "associated_symptoms",
      "phase": "history",
      "fact_key": "associated_symptoms",
      "prompt": "除了最主要的问题，还有哪些同时出现的不舒服？没有也请直接说没有。",
      "input": "text_or_absent"
    },
    {
      "id": "gi_details",
      "phase": "history",
      "fact_key": "gi_details",
      "input": "text_or_absent",
      "prompt": "腹痛在哪个位置、是什么样的痛（绞痛、胀痛还是隐痛）？和吃饭、排便有关系吗？有没有呕吐、腹泻、便血或发热？",
      "applies_when": {
        "chief_complaint_contains_any": [
          "腹痛",
          "肚子疼",
          "肚子痛",
          "胃痛",
          "胃疼",
          "腹泻",
          "拉肚子"
        ]
      }
    },
    {
      "id": "head_details",
      "phase": "history",
      "fact_key": "head_details",
      "input": "text_or_absent",
      "prompt": "头痛在哪个部位、是什么样的痛？是突然一下达到最剧烈，还是慢慢加重的？有没有呕吐、看东西模糊、发热、脖子发硬或者肢体无力？",
      "applies_when": {
        "chief_complaint_contains_any": [
          "头痛",
          "头疼"
        ]
