{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".env": ".env.*",
    ".gitignore": ".gitattributes, .ignore",
    "package.json": "package-lock.json, playwright.config.mjs"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    ".git": true,
    ".runtime": true,
    ".venv": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".hypothesis": true,
    ".coverage": true,
    ".coverage.*": true,
    ".workbuddy": true,
    "node_modules": true,
    "build": true,
    "dist": true,
    "output": true,
    "test-results": true,
    "playwright-report": true
  },
  "search.exclude": {
    "docs/evaluations": true,
    "docs/review-packets": true,
    "docs/assets": true,
    ".runtime": true,
    ".venv": true,
    "node_modules": true,
    "build": true,
    "dist": true,
    "output": true,
    "test-results": true
  },
  "files.watcherExclude": {
    "**/.runtime/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/test-results/**": true,
    "**/docs/evaluations/**": true
  }
}
